# ============================================================
# IVY HOMES — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── DATABASE ─────────────────────────────────────────────────
# Neon PostgreSQL connection string (set in Render)
DATABASE_URL=

# ── SERVER ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Production: https://ivy-home-client.vercel.app,http://localhost:5173
CLIENT_ORIGIN=https://ivy-home-client.vercel.app,http://localhost:5173

# ── IVY HOMES API ────────────────────────────────────────────
# Never expose IVY_API_KEY to the browser
IVY_BASE_URL=https://solve.ivy.homes
IVY_API_KEY=
IVY_ASSIGNED_LOCALITY=Manikonda
IVY_DEMO_PASSWORD=

# ── SEEDED SUPERADMIN ────────────────────────────────────────
SUPERADMIN_EMAIL=admin@ivy.local
SUPERADMIN_PASSWORD=

# ── SMTP (optional) ──────────────────────────────────────────
# Leave blank to log OTPs to the server console (good for dev/demo).
# Fill in for real email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ivy Homes <noreply@ivy.local>

# ── FRONTEND (Vite / Vercel) ─────────────────────────────────
# Set in Vercel dashboard under Environment Variables.
# Empty = uses Vite dev proxy (localhost).
# Production: https://ivy-home.onrender.com
VITE_API_URL=https://ivy-home.onrender.com

# ── CANDIDATE (submission.json generation) ───────────────────
CANDIDATE_NAME=
CANDIDATE_EMAIL=
CANDIDATE_REPO_URL=
CANDIDATE_DEMO_URL=
